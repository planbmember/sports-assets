{
  "name": "sports-assets",
  "version": "0.8.1",
  "description": "Static sports asset pack (sport icons, league/team logos, athlete images)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/planbmember/sports-assets.git"
  },
